# 相机固定名绑定：优先用序列号，没有序列号的用 VID/PID。
# 安装：
#   sudo install -m 0644 udev/99-camera-symlinks.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger --action=add --subsystem-match=video4linux

# HJ USB 2.0 Camera（序列号 SN0001）→ /dev/camera_upper（上相机，照圆环）
SUBSYSTEM=="video4linux", ATTRS{serial}=="SN0001", ENV{ID_V4L_CAPABILITIES}=="*capture*", MODE="0666", SYMLINK+="camera_upper"

# UNIQUESKY_CAR_CAMERA（1bcf:0b09，无序列号）→ /dev/camera_front（主相机，扫二维码）
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="1bcf", ATTRS{idProduct}=="0b09", ENV{ID_V4L_CAPABILITIES}=="*capture*", MODE="0666", SYMLINK+="camera_front"

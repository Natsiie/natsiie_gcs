# 用 USB 序列号绑定固定相机名（两台相机串号不同，插哪个口都不变）
# 安装：
#   sudo cp 本文件 /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger

# HJ USB 2.0 Camera（序列号 SN0001）→ /dev/camera_upper（上相机，照圆环）
SUBSYSTEM=="video4linux", ATTRS{serial}=="SN0001", ENV{ID_V4L_CAPABILITIES}=="*capture*", MODE="0666", SYMLINK+="camera_upper"

# TM Technology USB CAMERA（序列号 EP.20CC54K01）→ /dev/camera_front（主相机，扫二维码）
SUBSYSTEM=="video4linux", ATTRS{serial}=="EP.20CC54K01", ENV{ID_V4L_CAPABILITIES}=="*capture*", MODE="0666", SYMLINK+="camera_front"
